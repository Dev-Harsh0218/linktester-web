{
  "name": "linktester-web",
  "private": true,
  "version": "0.1.0",
  "description": "LinkTester client monorepo — marketing site + user panel. Both consume the linktester Django API.",
  "packageManager": "pnpm@11.0.9",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": { "node": ">=20" }
}
